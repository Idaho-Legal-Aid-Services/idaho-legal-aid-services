diff -ruN a/src/Request/ListVectors.php b/src/Request/ListVectors.php
--- a/src/Request/ListVectors.php	1969-12-31 17:00:00.000000000 -0700
+++ b/src/Request/ListVectors.php	2026-09-09 13:46:40.913184108 -0600
@@ -0,0 +1,79 @@
+<?php
+
+namespace Drupal\ai_vdb_provider_pinecone\Request;
+
+use Saloon\Enums\Method;
+use Saloon\Http\Request;
+use Saloon\Http\Response;
+use Saloon\Traits\RequestProperties\HasQuery;
+
+/**
+ * Lists the vector IDs in a namespace, optionally filtered by an ID prefix.
+ *
+ * Only Pinecone serverless indexes support this endpoint, which is the only
+ * index type this integration supports.
+ *
+ * @link https://docs.pinecone.io/reference/api/2024-10/data-plane/list
+ */
+class ListVectors extends Request {
+
+  use HasQuery;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected Method $method = Method::GET;
+
+  /**
+   * Constructs the request.
+   *
+   * @param string|null $namespace
+   *   The namespace to list.
+   * @param string|null $prefix
+   *   Only return IDs starting with this prefix.
+   * @param int $limit
+   *   Page size; Pinecone allows at most 100.
+   * @param string|null $paginationToken
+   *   The "pagination.next" token from the previous page.
+   */
+  public function __construct(
+    protected ?string $namespace = NULL,
+    protected ?string $prefix = NULL,
+    protected int $limit = 100,
+    protected ?string $paginationToken = NULL,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function defaultQuery(): array {
+    $payload = [
+      'limit' => max(1, min(100, $this->limit)),
+    ];
+    if ($this->namespace !== NULL && $this->namespace !== '') {
+      $payload['namespace'] = $this->namespace;
+    }
+    if ($this->prefix !== NULL && $this->prefix !== '') {
+      $payload['prefix'] = $this->prefix;
+    }
+    if ($this->paginationToken !== NULL && $this->paginationToken !== '') {
+      $payload['paginationToken'] = $this->paginationToken;
+    }
+    return $payload;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function resolveEndpoint(): string {
+    return '/vectors/list';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasRequestFailed(Response $response): ?bool {
+    return $response->status() !== 200;
+  }
+
+}
