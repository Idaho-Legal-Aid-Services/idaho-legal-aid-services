 /**
  * Extends Pinecone with extra calls.
@@ -333,4 +335,69 @@
     return [];
   }
 
+  /**
+   * Lists the vector IDs in a namespace whose ID starts with a prefix.
+   *
+   * The AI Search backend stores one vector per chunk under
+   * "<search_api item id>:<chunk>", so deleting an item first has to discover
+   * its chunk IDs. Uses the serverless-only list endpoint and follows
+   * pagination.
+   *
+   * @param string $namespace
+   *   The namespace.
+   * @param string $prefix
+   *   The vector ID prefix.
+   * @param string $index_name
+   *   The index name.
+   * @param int $limit
+   *   Page size (Pinecone allows at most 100).
+   *
+   * @return string[]
+   *   The matching vector IDs. Empty when nothing matches, when the namespace
+   *   does not exist yet, or when the request fails (which is logged).
+   */
+  public function listIdsByPrefix(string $namespace, string $prefix, string $index_name, int $limit = 100): array {
+    $ids = [];
+    $pagination_token = NULL;
+    try {
+      $client = $this->getClientForIndex($index_name);
+      // Switch the connector to the data-plane host of this index.
+      $client->data();
+      do {
+        $response = $client->send(new ListVectors(
+          namespace: $namespace,
+          prefix: $prefix,
+          limit: $limit,
+          paginationToken: $pagination_token,
+        ));
+        $body = $response->array();
+        foreach ($body['vectors'] ?? [] as $vector) {
+          if (!empty($vector['id'])) {
+            $ids[] = (string) $vector['id'];
+          }
+        }
+        $pagination_token = $body['pagination']['next'] ?? NULL;
+      } while (is_string($pagination_token) && $pagination_token !== '');
+    }
+    catch (RequestException $exception) {
+      // A namespace that does not exist yet has nothing to list.
+      if ($exception->getResponse()->status() === 404) {
+        return $ids;
+      }
+      $this->loggerChannelFactory->get('ai_vdb_provider_pinecone')->warning('Listing Pinecone vectors by prefix @prefix in namespace @namespace failed: @exception', [
+        '@prefix' => $prefix,
+        '@namespace' => $namespace,
+        '@exception' => $exception->getMessage(),
+      ]);
+    }
+    catch (\Exception $exception) {
+      $this->loggerChannelFactory->get('ai_vdb_provider_pinecone')->warning('Listing Pinecone vectors by prefix @prefix in namespace @namespace failed: @exception', [
+        '@prefix' => $prefix,
+        '@namespace' => $namespace,
+        '@exception' => $exception->getMessage(),
+      ]);
+    }
+    return array_values(array_unique($ids));
+  }
+
 }
