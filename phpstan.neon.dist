parameters:
  level: 2
  paths:
    - web/modules/custom
    - web/themes/custom
  excludePaths:
    - web/modules/custom/*/node_modules/*
    - web/themes/custom/*/node_modules/*
    - web/modules/custom/*/vendor/*
    - web/themes/custom/*/vendor/*
    - web/modules/custom/*/dist/*
    - web/themes/custom/*/dist/*
    - web/modules/custom/*/tests/fixtures/*
  # Pre-bootstrap helpers that live outside the analysed paths but are called
  # from tests inside them.
  scanFiles:
    - web/sites/default/settings.search-guard.php

includes:
  - phpstan-baseline.neon
